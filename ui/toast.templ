package ui

templ Toast() {
	<div id="toast-container" popover="manual" class="toast toast-top toast-end z-50 m-0 border-0 bg-transparent p-0 shadow-none" x-data="toastContainer">
		<template x-for="toast in store.toasts" :key="toast.id">
			<div
				class="alert relative overflow-hidden"
				:class="'alert-' + toast.type"
				@mouseenter="store.pauseTimer(toast.id)"
				@mouseleave="store.resumeTimer(toast.id)"
			>
				<span x-text="toast.message"></span>
				<button
					type="button"
					class="btn btn-xs btn-ghost btn-circle ml-auto shrink-0"
					@click="store.removeToast(toast.id)"
					aria-label="Close"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
				</button>
				<div
					class="absolute bottom-0 left-0 h-0.5 bg-current opacity-50 w-full"
					:style="'animation: toast-shrink ' + toast.duration + 'ms linear forwards; animation-play-state: ' + (toast.paused ? 'paused' : 'running') + ';'"
				></div>
			</div>
		</template>
	</div>
}
