package ui

import "strconv"

// NotificationBellProps configures the shared notification bell component.
// Dynamic state (unread count, list, loading) is driven by the Alpine.js
// notificationCenter store registered by @frontend-common/core.
type NotificationBellProps struct {
	ID                string
	SummaryEndpoint   string
	ListEndpoint      string
	MarkReadEndpoint  string
	BulkMarkReadEndpoint string
	InitialPageSize   int
	FetchPageSize     int
	HoverConsiderMs   int
	BulkSendMs        int
	Title             string
	EmptyLabel        string
	LoadingLabel      string
	ErrorLabel        string
	RefreshLabel      string
	DemoButtonLabel   string
	AriaLabel         string
}

templ NotificationBell(props NotificationBellProps) {
	{{ dropdownID := props.ID + "-dropdown" }}
	{{ listID := props.ID + "-list" }}
	<div
		id={ props.ID }
		class="relative inline-block"
		x-data="notificationBell"
		x-init={"initFromDOM('" + props.ID + "', '" + dropdownID + "')" }
		data-summary-endpoint={ props.SummaryEndpoint }
		data-list-endpoint={ props.ListEndpoint }
		data-mark-read-endpoint={ props.MarkReadEndpoint }
		data-bulk-mark-read-endpoint={ props.BulkMarkReadEndpoint }
		data-initial-page-size={ strconv.Itoa(props.InitialPageSize) }
		data-fetch-page-size={ strconv.Itoa(props.FetchPageSize) }
		data-hover-consider-ms={ strconv.Itoa(props.HoverConsiderMs) }
		data-bulk-send-ms={ strconv.Itoa(props.BulkSendMs) }
		data-title={ props.Title }
		data-empty-label={ props.EmptyLabel }
		data-loading-label={ props.LoadingLabel }
		data-error-label={ props.ErrorLabel }
		data-refresh-label={ props.RefreshLabel }
		data-demo-button-label={ props.DemoButtonLabel }
		data-aria-label={ props.AriaLabel }
	>
		<button
			type="button"
			class="btn btn-ghost btn-circle"
			aria-label={ props.AriaLabel }
			aria-haspopup="true"
			aria-expanded="false"
			:aria-expanded="store.isOpen"
			@click.stop="toggle()"
		>
			<div class="indicator">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
				</svg>
				<span
					class="indicator-item badge badge-sm badge-primary"
					:class="{ 'animate-bounce': store.unreadCount > 0 && store.badgePulse }"
					x-show="store.unreadCount > 0"
					x-text="store.unreadCount"
				></span>
			</div>
		</button>
		<div
			id={ dropdownID }
			class="absolute top-full right-0 z-[100] card card-compact w-80 sm:w-96 bg-base-100 shadow-xl mt-2"
			x-show="store.isOpen"
			x-cloak
		>
			<div class="card-body p-0">
				<div class="px-4 py-3 border-b border-base-200 flex justify-between items-center">
					<h3 class="font-bold text-base" x-text="title"></h3>
					<button
						type="button"
						class="btn btn-xs btn-ghost"
						x-show="store.hasNew"
						@click="store.refresh()"
						x-text="refreshLabel"
					></button>
				</div>
				<div
					id={ listID }
					class="overflow-y-auto max-h-[24rem]"
					@scroll="onScroll()"
				>
					<div x-show="store.loading && store.notifications.length === 0" class="p-4 text-center opacity-70">
						<span class="loading loading-spinner loading-sm"></span>
						<span class="ml-2" x-text="loadingLabel"></span>
					</div>
					<div x-show="store.error" class="p-4 alert alert-error text-sm" x-text="errorLabel"></div>
					<div x-show="!store.loading && store.notifications.length === 0" class="p-8 text-center opacity-70" x-text="emptyLabel"></div>
					<template x-for="n in store.notifications" :key="n.id">
						<div
							class="relative px-4 py-3 border-b border-base-200 hover:bg-base-200 transition-colors cursor-pointer overflow-hidden"
							:class="{ 'bg-base-200/50': !n.read }"
							@pointerenter="onPointerEnter($event, n)"
							@pointerleave="onPointerLeave($event, n)"
							@focusin="onFocusIn(n)"
							@focusout="onFocusOut(n)"
							@click="onClick(n)"
							tabindex="0"
							role="listitem"
							:aria-label="n.read ? 'read notification' : 'unread notification'"
						>
							<div class="flex justify-between items-start gap-2">
								<p class="font-semibold text-sm" x-text="n.title"></p>
								<span class="text-xs opacity-60 whitespace-nowrap" x-text="formatTime(n.created_at)"></span>
							</div>
							<p class="text-sm opacity-80 mt-1" x-text="n.body"></p>
							<template x-if="!n.read && hoveredId === n.id">
								<div
									class="absolute bottom-0 left-0 h-0.5 bg-primary opacity-70 w-full"
									:style="'animation: hover-progress ' + hoverConsiderMs + 'ms linear forwards'"
								></div>
							</template>
						</div>
					</template>
					<div x-show="store.loading && store.notifications.length > 0" class="p-3 text-center">
						<span class="loading loading-spinner loading-xs"></span>
					</div>
				</div>
			</div>
		</div>
	</div>
}
